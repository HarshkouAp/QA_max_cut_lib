{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/QA_max_cut_lib/parallelism-v1.json",
  "title": "QA_max_cut_lib parallelism sweep",
  "type": "object",
  "required": ["schema_version", "num_treads_values"],
  "properties": {
    "schema_version": {"const": 1},
    "num_treads_values": {"type": "array", "minItems": 1, "items": {"type": "integer", "minimum": 1}, "uniqueItems": true},
    "parameter_coverage": {"enum": ["full_grid"]},
    "seed_index": {"type": "integer", "minimum": 0},
    "seed": {"type": "integer"},
    "warmup_runs": {"type": "integer", "minimum": 0},
    "repetitions": {"type": "integer", "minimum": 1},
    "execution_mode": {"enum": ["isolated", "concurrent_batch"]},
    "timing_scope": {"enum": ["benchmark", "end_to_end", "solve_only"]},
    "measurement_order": {"enum": ["shuffle_within_case_repetition", "fixed"]},
    "measurement_order_seed": {"type": "integer"},
    "models": {"type": "array"},
    "uncertainty": {"type": "object"},
    "recommendation": {"type": "object"},
    "series_limits": {"type": "object"},
    "save": {"type": "object"},
    "case_weights": {"type": "object"}
  },
  "additionalProperties": false
}
