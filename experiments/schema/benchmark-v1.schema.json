{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/QA_max_cut_lib/benchmark-v1.json",
  "title": "QA_max_cut_lib benchmark specification",
  "type": "object",
  "required": ["schema_version", "trial_seeds", "graph_cases", "solver_cases"],
  "properties": {
    "schema_version": {"const": 1},
    "plan_seed": {"type": "integer"},
    "trial_seeds": {"type": "array", "minItems": 1, "items": {"type": "integer", "minimum": 0}, "uniqueItems": true},
    "graph_cases": {"type": "array", "minItems": 1},
    "solver_templates": {"type": "object"},
    "solver_cases": {"type": "array", "minItems": 1},
    "references": {"type": "object"},
    "execution": {"type": "object"},
    "measurement": {"type": "object"},
    "series_limits": {"type": "object"},
    "metrics": {"type": "object"},
    "failure_policy": {"type": "object"},
    "collect": {"type": "object"},
    "save": {"type": "object"},
    "planner_limits": {"type": "object"}
  },
  "additionalProperties": false
}
