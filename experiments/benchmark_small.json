{
  "schema_version": 1,
  "plan_seed": 2026,
  "trial_seeds": [11, 29],
  "graph_cases": [
    {
      "name": "signed_small",
      "recipe": {
        "schema_version": 1,
        "type": "complete",
        "parameters": {"n_vertices": 8},
        "seed": 1000,
        "weights": {
          "type": "signed_discrete",
          "parameters": {"values": [-3, -1, 1, 3]},
          "seed": 1001
        }
      },
      "grid": [
        {"path": ["parameters", "n_vertices"], "values": [8, 10]}
      ]
    }
  ],
  "solver_templates": {
    "qaoa_cpu_base": {
      "schema_version": 1,
      "type": "qaoa_cpu",
      "parameters": {"layers": 1},
      "objective": {"type": "mean_cut"},
      "estimation": {"mode": "shots", "shots_per_evaluation": 32},
      "optimizer": {
        "type": "adam",
        "parameters": {"max_steps": 2, "learning_rate": 0.05},
        "gradient": {"type": "central_difference", "parameters": {"step": 0.01}}
      },
      "readout": {"mode": "best_of_shots", "shots": 64},
      "limits": {"shots_total": 2048}
    }
  },
  "solver_cases": [
    {
      "name": "qaoa_mean",
      "template": "qaoa_cpu_base",
      "grid": [
        {"path": ["parameters", "layers"], "values": [1, 2]},
        {"path": ["estimation", "shots_per_evaluation"], "values": [32, 64]}
      ]
    },
    {
      "name": "qaoa_cvar",
      "template": "qaoa_cpu_base",
      "overrides": [
        {"path": ["objective"], "value": {"type": "cvar", "parameters": {"alpha": 0.1}}}
      ],
      "grid": [
        {"path": ["parameters", "layers"], "values": [1, 2]},
        {"path": ["estimation", "shots_per_evaluation"], "values": [32, 64]},
        {"path": ["objective", "parameters", "alpha"], "values": [0.1, 0.5]}
      ]
    },
    {
      "name": "sa",
      "config": {
        "schema_version": 1,
        "type": "simulated_annealing_cpu",
        "parameters": {
          "num_reads": 4,
          "num_sweeps": 64,
          "beta_range": [0.1, 4.0],
          "beta_schedule_type": "geometric"
        }
      },
      "grid": [
        {"path": ["parameters", "num_reads"], "values": [4, 8]}
      ]
    }
  ],
  "references": {
    "type": "tiered",
    "exact": {"max_vertices": 12, "include_minimum": false},
    "gw": {
      "max_vertices": 64,
      "config": {"type": "gw_cpu", "parameters": {"num_hyperplanes": 16}},
      "seed": 9100
    },
    "best_known": {"sources": []}
  },
  "execution": {
    "mode": "isolated",
    "cpu_slots": 4,
    "solver_num_treads": 1,
    "gpu_policy": "exclusive_one_owner"
  },
  "measurement": {
    "timing_scope": "end_to_end",
    "solver_lifecycle": "fresh",
    "synchronize_gpu": true,
    "trial_output": {"report": 0, "logs": 0},
    "trial_save": false
  },
  "series_limits": {"max_runs_total": 400, "shots_total": null},
  "metrics": {
    "fields": ["cut_value", "energy", "optimality_gap", "success"],
    "success": {"type": "fraction_of_exact_max", "fraction": 0.9}
  },
  "failure_policy": {"on_trial_error": "continue", "retry_failed": false},
  "collect": {"trial_records": true, "raw_measurements": true},
  "save": {
    "path": "results/series",
    "atts": ["expanded_plan", "trials", "references", "summary", "errors"],
    "filename": "small_comparison",
    "save_original_data": [],
    "makedir": true,
    "savedir": true
  }
}
