{
  "schema_version": 1,
  "trial_seeds": [5],
  "graph_cases": [
    {
      "name": "mixed_signed",
      "recipe": {
        "schema_version": 1,
        "type": "complete",
        "parameters": {"n_vertices": 8},
        "seed": 4100,
        "weights": {
          "type": "signed_discrete",
          "parameters": {"values": [-3, -1, 1, 3]},
          "seed": 4101
        }
      }
    }
  ],
  "solver_cases": [
    {
      "name": "qaoa_cpu",
      "config": {
        "schema_version": 1,
        "type": "qaoa_cpu",
        "parameters": {"layers": 1, "max_vertices": 8},
        "objective": {"type": "mean_cut"},
        "estimation": {"mode": "exact"},
        "optimizer": {
          "type": "adam",
          "parameters": {"max_steps": 1, "learning_rate": 0.05},
          "gradient": {"type": "central_difference", "parameters": {"step": 0.01}}
        },
        "readout": {"mode": "most_probable"}
      }
    },
    {
      "name": "qaoa_gpu",
      "config": {
        "schema_version": 1,
        "type": "qaoa_gpu",
        "parameters": {"layers": 1, "max_vertices": 8, "dtype": "complex64", "representation": "spin_flip_pairs"},
        "gpu": {"device_id": 0, "memory": {"fraction_of_available": 0.7, "reserve_bytes": 268435456}},
        "objective": {"type": "mean_cut"},
        "estimation": {"mode": "exact"},
        "optimizer": {
          "type": "adam",
          "parameters": {"max_steps": 1, "learning_rate": 0.05},
          "gradient": {"type": "central_difference", "parameters": {"step": 0.01}}
        },
        "readout": {"mode": "most_probable"},
        "limits": {"shots_total": 0}
      }
    },
    {
      "name": "sa",
      "config": {
        "schema_version": 1,
        "type": "simulated_annealing_cpu",
        "parameters": {"num_reads": 6, "num_sweeps": 32, "beta_range": [0.1, 4.0], "beta_schedule_type": "geometric"}
      }
    }
  ],
  "references": {
    "type": "tiered",
    "exact": {"max_vertices": 12, "include_minimum": false},
    "gw": {"max_vertices": 64, "config": {"type": "gw_cpu", "parameters": {"num_hyperplanes": 4}}, "seed": 6100},
    "best_known": {"sources": []}
  },
  "execution": {
    "mode": "isolated",
    "cpu_slots": 4,
    "solver_num_treads": 1,
    "gpu_policy": "exclusive_one_owner"
  },
  "measurement": {
    "timing_scope": "end_to_end",
    "solver_lifecycle": "fresh",
    "synchronize_gpu": true,
    "trial_output": {"report": 0, "logs": 0},
    "trial_save": false
  },
  "series_limits": {"max_runs_total": 20, "shots_total": null},
  "metrics": {
    "fields": ["cut_value", "energy", "optimality_gap", "success"],
    "success": {"type": "fraction_of_exact_max", "fraction": 0.9}
  },
  "failure_policy": {"on_trial_error": "continue", "retry_failed": false},
  "collect": {"trial_records": true, "raw_measurements": true},
  "save": {
    "path": "results/mixed",
    "atts": ["expanded_plan", "trials", "references", "summary", "errors"],
    "filename": "mixed_cpu_gpu",
    "save_original_data": [],
    "makedir": true,
    "savedir": true
  }
}
