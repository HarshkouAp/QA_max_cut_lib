{
  "schema_version": 1,
  "type": "laboratory.distributed_ls_rqaoa_cpu",
  "seed": 20261102,
  "num_treads": 2,
  "parameters": {
    "finish_at": 4,
    "max_reductions": 2
  },
  "messages": {
    "initial": {
      "type": "biased_spins",
      "parameters": {
        "amplitude": 0.1,
        "spins": {
          "type": "all_plus"
        }
      }
    },
    "episode_mean_aggregation": "uniform",
    "transport": {
      "type": "carry_survivor_means",
      "partition": "rebuild",
      "block_moments": "product_reset",
      "angles": "restart"
    }
  },
  "partition_builder": {
    "type": "greedy_abs_weight_partition",
    "parameters": {
      "max_size": 3,
      "rounds": 1,
      "full_graph_when_fits": true
    }
  },
  "correlation_source": {
    "type": "mean_field_episodes_cpu",
    "parameters": {
      "layers": 1,
      "max_block_vertices": 18,
      "dtype": "complex128"
    },
    "episode_initialization": "same_parent_means",
    "episode_execution": "sequential",
    "mean_field": {
      "max_sweeps": 1,
      "schedule": {
        "type": "jacobi",
        "block_order": "as_planned"
      },
      "moment_damping": 0.5,
      "angle_damping": 1.0,
      "acceptance": "always",
      "optimizer_state_policy": "restart_each_update",
      "stopping": {
        "type": "max_sweeps"
      }
    },
    "initialization": {
      "type": "fixed_angles",
      "parameters": {
        "values": [
          0.4,
          0.2
        ]
      }
    },
    "local_solver": {
      "type": "qaoa_ising_statevector_cpu",
      "objective": {
        "type": "mean_cut",
        "parameters": {}
      },
      "objective_reference": "local_surrogate",
      "estimation": {
        "mode": "shots",
        "shots_per_evaluation": 8
      },
      "optimizer": {
        "type": "adam",
        "parameters": {
          "max_steps": 1,
          "learning_rate": 0.05,
          "gradient_tolerance": 0.0
        },
        "gradient": {
          "type": "central_difference",
          "parameters": {
            "step": 0.01
          }
        }
      }
    },
    "moments": {
      "mode": "shots",
      "shots": 8,
      "statistics": [
        "z_all",
        "zz_internal_edges"
      ],
      "shared_sample": true
    },
    "final_correlations": {
      "mode": "shots",
      "shots": 16
    }
  },
  "aggregation": {
    "type": "mean",
    "parameters": {}
  },
  "selection": {
    "type": "max_abs_correlation",
    "parameters": {
      "pairs": "edges",
      "zero_sign": 1
    }
  },
  "coverage": {
    "require_full": false,
    "empty_policy": "anchor_partition"
  },
  "update": {
    "type": "refresh_all"
  },
  "fallback": {
    "type": "sign_parent_means",
    "zero_sign": 1
  },
  "execution": {
    "backend": "process",
    "start_method": "spawn",
    "native_threads": 1
  },
  "budget_policy": {
    "type": "parent_step_round_robin"
  },
  "finisher": {
    "type": "exact_cpu",
    "parameters": {
      "max_vertices": 16,
      "batch_size": 65536
    }
  },
  "limits": {
    "shots_total": 512,
    "max_block_updates_total": 8
  },
  "checkpoint": {
    "enabled": true,
    "path": "checkpoints/distributed_ls",
    "every": {
      "optimizer_iterations": 1
    },
    "durable_resource_journal": true
  },
  "collect": {
    "reduction_history": true,
    "message_transport_history": true,
    "episode_history": true,
    "parameter_trajectory": true,
    "local_optimizer_history": true,
    "final_correlation_tables": true,
    "final_reduction_state": true
  },
  "output": {
    "report": 0,
    "logs": 0
  }
}
