{
  "schema_version": 1,
  "type": "qaoa_gpu",
  "seed": 20261102,
  "num_treads": 1,
  "parameters": {
    "layers": 1,
    "max_vertices": 30,
    "dtype": "complex64",
    "representation": "spin_flip_pairs"
  },
  "gpu": {
    "device_id": 0,
    "memory": {"fraction_of_available": 0.8, "reserve_bytes": 268435456}
  },
  "objective": {"type": "cvar", "parameters": {"alpha": 0.5}},
  "estimation": {"mode": "shots", "shots_per_evaluation": 64},
  "optimizer": {
    "type": "adam",
    "parameters": {"max_steps": 2, "learning_rate": 0.05}
  },
  "initialization": {"type": "fixed_angles", "parameters": {"values": [0.7, -0.3]}},
  "readout": {"mode": "best_of_shots", "shots": 256},
  "limits": {"shots_total": 2000},
  "collect": {
    "optimizer_history": true,
    "correlations": true
  },
  "output": {"report": 1, "logs": 1, "color": "auto"},
  "save": {
    "path": "results/qaoa_gpu",
    "atts": ["solution", "optimizer_history", "correlations"],
    "filename": "gpu_cvar_shots_example",
    "save_original_data": [],
    "makedir": true,
    "savedir": true
  }
}
