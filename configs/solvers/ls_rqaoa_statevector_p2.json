{
  "schema_version": 1,
  "type": "ls_rqaoa_cpu",
  "seed": 20261102,
  "num_treads": 2,
  "parameters": {"finish_at": 5, "max_reductions": null},
  "subgraph_builder": {
    "type": "greedy_abs_weight_partition",
    "parameters": {
      "max_size": 8,
      "rounds": 2,
      "full_graph_when_fits": false,
      "boundary": "induced_no_fields"
    }
  },
  "correlation_source": {
    "type": "qaoa_statevector_cpu",
    "parameters": {"layers": 2, "max_vertices": 20, "dtype": "complex128"},
    "objective": {"type": "mean_cut", "parameters": {}},
    "objective_reference": "working_graph",
    "estimation": {"mode": "exact"},
    "optimizer": {
      "type": "adam",
      "parameters": {
        "max_steps": 4,
        "learning_rate": 0.05,
        "beta1": 0.9,
        "beta2": 0.999,
        "epsilon": 1e-08,
        "gradient_tolerance": 0.0
      }
    },
    "initialization": {
      "type": "fixed_angles",
      "parameters": {"values": [0.5, 0.5, 0.25, 0.25]}
    },
    "correlations": {"mode": "exact"}
  },
  "aggregation": {"type": "mean", "parameters": {}},
  "selection": {
    "type": "max_abs_correlation",
    "parameters": {"pairs": "edges", "zero_sign": 1}
  },
  "coverage": {"require_full": false, "empty_policy": "anchor_pair"},
  "update": {"type": "refresh_all"},
  "execution": {"backend": "process", "start_method": "spawn", "native_threads": 1},
  "budget_policy": {"type": "step_round_robin"},
  "finisher": {
    "type": "exact_cpu",
    "parameters": {"max_vertices": 16, "batch_size": 65536}
  },
  "limits": {"shots_total": 0, "max_local_tasks_total": null},
  "collect": {
    "reduction_history": true,
    "parameter_trajectory": true,
    "local_task_history": true,
    "local_optimizer_history": true,
    "correlation_tables": false,
    "final_reduction_state": false
  },
  "output": {"report": 1, "logs": 1, "color": "auto"},
  "save": {
    "path": "results/ls_rqaoa",
    "atts": ["solution", "reduction_history", "parameter_trajectory", "local_task_history"],
    "filename": "ls_statevector_p2_example",
    "save_original_data": [],
    "makedir": true,
    "savedir": true
  }
}
