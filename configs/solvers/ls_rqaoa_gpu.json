{
  "schema_version": 1,
  "type": "ls_rqaoa_gpu",
  "seed": 20261102,
  "num_treads": 2,
  "parameters": {"finish_at": 3, "max_reductions": 8},
  "subgraph_builder": {
    "type": "greedy_abs_weight_partition",
    "parameters": {
      "max_size": 6,
      "rounds": 2,
      "full_graph_when_fits": true,
      "boundary": "induced_no_fields"
    }
  },
  "correlation_source": {
    "type": "qaoa_statevector_gpu",
    "parameters": {
      "layers": 1,
      "max_vertices": 8,
      "dtype": "complex64",
      "representation": "spin_flip_pairs"
    },
    "gpu": {
      "device_id": 0,
      "memory": {"fraction_of_available": 0.8, "reserve_bytes": 268435456}
    },
    "objective": {"type": "mean_cut", "parameters": {}},
    "objective_reference": "working_graph",
    "estimation": {"mode": "exact"},
    "optimizer": {"type": "adam", "parameters": {"max_steps": 1}},
    "initialization": {"type": "fixed_angles", "parameters": {"values": [0.4, 0.2]}},
    "correlations": {"mode": "exact"}
  },
  "aggregation": {"type": "mean", "parameters": {}},
  "selection": {"type": "max_abs_correlation", "parameters": {"pairs": "edges"}},
  "coverage": {"require_full": false, "empty_policy": "anchor_pair"},
  "update": {"type": "refresh_all"},
  "execution": {"backend": "gpu_owner", "start_method": "spawn", "native_threads": 1},
  "budget_policy": {"type": "step_round_robin"},
  "finisher": {"type": "exact_cpu", "parameters": {"max_vertices": 8}},
  "limits": {"shots_total": 0},
  "collect": {
    "reduction_history": true,
    "parameter_trajectory": true,
    "local_task_history": true
  },
  "output": {"report": 1, "logs": 1, "color": "auto"},
  "save": {
    "path": "results/qaoa_gpu",
    "atts": ["solution", "reduction_history", "parameter_trajectory", "local_task_history"],
    "filename": "ls_rqaoa_gpu_example",
    "save_original_data": [],
    "makedir": true,
    "savedir": true
  }
}
