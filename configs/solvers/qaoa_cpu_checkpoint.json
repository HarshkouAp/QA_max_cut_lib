{
  "schema_version": 1,
  "type": "qaoa_cpu",
  "seed": 42,
  "num_treads": 1,
  "parameters": {"layers": 1},
  "objective": {"type": "mean_cut", "parameters": {}},
  "estimation": {"mode": "shots", "shots_per_evaluation": 32},
  "optimizer": {
    "type": "adam",
    "parameters": {
      "max_steps": 4,
      "learning_rate": 0.05,
      "gradient_tolerance": 0.0
    },
    "gradient": {"type": "central_difference", "parameters": {"step": 0.01}}
  },
  "initialization": {"type": "fixed_angles", "parameters": {"values": [0.5, 0.3]}},
  "readout": {"mode": "best_of_shots", "shots": 64},
  "limits": {"shots_total": 704},
  "checkpoint": {
    "enabled": true,
    "path": "results/checkpoints/qaoa_control",
    "format": "json_npy_v1",
    "every": {"optimizer_iterations": 1},
    "at_phase_boundaries": true,
    "on_pause": true,
    "durable_resource_journal": true,
    "durability": "local_fsync",
    "on_write_error": "stop",
    "retention": {"type": "keep_all"}
  },
  "collect": {"optimizer_history": true, "objective_history": true},
  "output": {"report": 0, "logs": 0, "color": "auto"}
}
