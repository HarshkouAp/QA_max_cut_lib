{
  "type": "laboratory.incremental_ls_rqaoa_cpu",
  "seed": 17,
  "num_treads": 2,
  "limits": {
    "max_reductions": 2,
    "max_total_shots": 224,
    "max_tasks_per_epoch": 4,
    "max_total_tasks": 8
  },
  "finish_at": 4,
  "pairs": "edges",
  "zero_sign": 1,
  "require_full_coverage": false,
  "local_problem": {
    "boundary": "induced_no_fields"
  },
  "initial_builder": {
    "type": "single_densest_edge_count_v1",
    "max_size": 3,
    "rounds": 1,
    "full_graph_when_fits": true,
    "n_restarts": 20,
    "local_iter": 500,
    "candidate_pool": 64
  },
  "update": {
    "type": "survivor_neighbor_cover_v1",
    "growth_metric": "count"
  },
  "bank": {
    "aggregation": "epoch_mean",
    "policy": "current_epoch_only"
  },
  "selection": {
    "type": "max_abs_weighted_correlation",
    "weight_power": 2
  },
  "correlation_source": {
    "type": "qaoa_statevector_cpu",
    "p": 1,
    "training": {
      "criterion": "mean_cut",
      "mode": "shots",
      "shots": 8,
      "optimizer": "adam",
      "max_steps": 1,
      "gradient_tolerance": 0
    },
    "correlations": {
      "mode": "shots",
      "shots": 16
    },
    "objective_reference": "working_graph"
  },
  "finisher": {
    "type": "exact_cpu",
    "max_nodes": 4
  },
  "collect": {
    "summary": true,
    "epoch_bank": true,
    "local_histories": false
  },
  "report": 1,
  "logs": 0,
  "output": {
    "report": 1,
    "logs": 0,
    "color": "auto"
  }
}
