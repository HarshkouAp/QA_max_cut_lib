{
  "schema_version": 1,
  "type": "rqaoa_gpu",
  "seed": 20261102,
  "num_treads": 1,
  "parameters": {"finish_at": 4},
  "correlation_source": {
    "type": "qaoa_statevector_gpu",
    "parameters": {
      "layers": 1,
      "max_vertices": 20,
      "dtype": "complex64",
      "representation": "spin_flip_pairs"
    },
    "gpu": {
      "device_id": 0,
      "memory": {"fraction_of_available": 0.8, "reserve_bytes": 268435456}
    },
    "objective": {"type": "mean_cut", "parameters": {}},
    "objective_reference": "working_graph",
    "estimation": {"mode": "exact"},
    "optimizer": {"type": "adam", "parameters": {"max_steps": 2}},
    "initialization": {"type": "fixed_angles", "parameters": {"values": [0.5, 0.2]}},
    "correlations": {"mode": "exact"}
  },
  "selection": {
    "type": "max_abs_correlation",
    "parameters": {"pairs": "edges", "zero_sign": 1}
  },
  "finisher": {"type": "exact_cpu", "parameters": {"max_vertices": 16}},
  "limits": {"shots_total": 0},
  "collect": {
    "reduction_history": true,
    "parameter_trajectory": true
  },
  "output": {"report": 1, "logs": 1, "color": "auto"},
  "save": {
    "path": "results/qaoa_gpu",
    "atts": ["solution", "reduction_history", "parameter_trajectory"],
    "filename": "rqaoa_gpu_example",
    "save_original_data": [],
    "makedir": true,
    "savedir": true
  }
}
