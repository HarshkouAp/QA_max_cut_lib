{
  "schema_version": 1,
  "type": "laboratory.warm_start_qaoa_cpu",
  "seed": 43,
  "num_treads": 1,
  "parameters": {"layers": 1, "dtype": "complex128"},
  "warm_start": {
    "epsilon": 0.2,
    "source": {
      "type": "provided_probabilities",
      "parameters": {
        "entries": [
          {"node": -7, "probability": 0.1},
          {"node": 10, "probability": 0.6},
          {"node": 80, "probability": 0.95},
          {"node": 101, "probability": 0.45}
        ]
      }
    },
    "mixer": {"type": "warm_aligned"}
  },
  "objective": {"type": "mean_cut"},
  "estimation": {"mode": "shots", "shots_per_evaluation": 32},
  "optimizer": {
    "type": "adam",
    "parameters": {"max_steps": 1, "learning_rate": 0.05, "gradient_tolerance": 0.0},
    "gradient": {"type": "central_difference", "parameters": {"step": 0.01}}
  },
  "initialization": {"type": "fixed_angles", "parameters": {"values": [0.4, 0.2]}},
  "readout": {"mode": "best_of_shots", "shots": 64},
  "limits": {"shots_total": 224},
  "collect": {"probabilities": true, "optimizer_history": true},
  "output": {"report": 1, "logs": 0, "color": "auto"}
}
