{
  "schema_version": 1,
  "type": "refined",
  "seed": 9,
  "num_treads": 1,
  "base_solver": {
    "type": "rqaoa_cpu",
    "seed": 9,
    "parameters": {"finish_at": 3},
    "correlation_source": {
      "type": "qaoa_statevector_cpu",
      "parameters": {"layers": 1, "max_vertices": 10, "dtype": "complex128"},
      "objective": {"type": "mean_cut", "parameters": {}},
      "estimation": {"mode": "exact"},
      "optimizer": {
        "type": "adam",
        "parameters": {"max_steps": 1},
        "gradient": {"type": "central_difference", "parameters": {"step": 0.01}}
      },
      "initialization": {"type": "fixed_angles", "parameters": {"values": [0.7, -0.3]}},
      "correlations": {"mode": "exact"}
    },
    "selection": {"type": "max_abs_correlation", "parameters": {"pairs": "edges"}},
    "finisher": {"type": "exact_cpu", "parameters": {"max_vertices": 4}},
    "limits": {"shots_total": 0},
    "collect": {"reduction_history": false}
  },
  "refiner": {
    "type": "exact_block",
    "parameters": {"max_size": 6, "batch_size": 256, "max_passes": 1},
    "selector": {"type": "explicit_blocks", "parameters": {"blocks": [[0, 1]]}}
  },
  "limits": {"refinement_states_total": 64},
  "collect": {"base_run": true, "refinement_history": true},
  "output": {"report": 1, "logs": 0, "color": "auto"}
}
