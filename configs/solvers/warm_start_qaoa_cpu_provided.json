{
  "schema_version": 1,
  "type": "laboratory.warm_start_qaoa_cpu",
  "seed": 42,
  "num_treads": 1,
  "parameters": {"layers": 1, "dtype": "complex128"},
  "warm_start": {
    "epsilon": 0.25,
    "source": {
      "type": "provided_spins",
      "parameters": {
        "entries": [
          {"node": -7, "spin": 1},
          {"node": 10, "spin": -1},
          {"node": 80, "spin": 1},
          {"node": 101, "spin": -1}
        ]
      }
    },
    "mixer": {"type": "rounded_modified"}
  },
  "objective": {"type": "mean_cut"},
  "estimation": {"mode": "shots", "shots_per_evaluation": 32},
  "optimizer": {
    "type": "adam",
    "parameters": {
      "max_steps": 3,
      "learning_rate": 0.05,
      "gradient_tolerance": 0.0
    },
    "gradient": {
      "type": "central_difference",
      "parameters": {"step": 0.01}
    }
  },
  "initialization": {
    "type": "fixed_angles",
    "parameters": {"values": [0.4, 0.2]}
  },
  "readout": {"mode": "best_of_shots", "shots": 64},
  "limits": {"shots_total": 544},
  "checkpoint": {
    "enabled": true,
    "path": "checkpoints/ws_qaoa",
    "every": {"optimizer_iterations": 1},
    "durable_resource_journal": true
  },
  "collect": {
    "optimizer_history": true,
    "objective_history": true,
    "statevector": false,
    "probabilities": true
  },
  "output": {"report": 1, "logs": 0, "color": "auto"}
}
