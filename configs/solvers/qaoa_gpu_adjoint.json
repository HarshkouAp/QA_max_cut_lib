{
  "schema_version": 1,
  "type": "qaoa_gpu",
  "seed": 20261102,
  "num_treads": 1,
  "parameters": {
    "layers": 2,
    "max_vertices": 28,
    "dtype": "complex128",
    "representation": "spin_flip_pairs"
  },
  "gpu": {
    "device_id": 0,
    "diagonal_dtype": "float64",
    "accumulation_dtype": "float64",
    "memory": {"fraction_of_available": 0.8, "reserve_bytes": 268435456},
    "kernels": {"mixer": "pairwise", "cuda_graphs": false}
  },
  "objective": {"type": "mean_cut", "parameters": {}},
  "estimation": {"mode": "exact"},
  "optimizer": {
    "type": "adam",
    "parameters": {"max_steps": 3, "learning_rate": 0.05},
    "gradient": {"type": "adjoint", "parameters": {}}
  },
  "initialization": {
    "type": "fixed_angles",
    "parameters": {"values": [0.3, 0.2, 0.1, 0.4]}
  },
  "readout": {"mode": "most_probable"},
  "limits": {"shots_total": 0},
  "collect": {"optimizer_history": true, "correlations": true},
  "output": {"report": 1, "logs": 1, "color": "auto"},
  "save": {
    "path": "results/qaoa_gpu",
    "atts": ["solution", "optimal_angles", "optimizer_history", "state_representation"],
    "filename": "gpu_adjoint_example",
    "save_original_data": [],
    "makedir": true,
    "savedir": true
  }
}
