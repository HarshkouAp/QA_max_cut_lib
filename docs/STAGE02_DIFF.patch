+    "    root = root.parent\n",
+    "assert (root / 'configs').is_dir(), 'Open the notebook from the project or notebooks folder.'\n",
+    "stamp = datetime.now(timezone.utc).strftime('%Y%m%dT%H%M%SZ') + '_' + uuid4().hex[:6]\n",
