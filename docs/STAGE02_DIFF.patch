+    "print('QA_max_cut_lib', __version__)\n",
+    "print('Output:', output_dir)\n",
+    "\n",
+    "def cut(graph, spins):\n",
+    "    return math.fsum(w for u, v, w in graph.edges if spins[u] != spins[v])\n",
+    "\n",
+    "def energy(problem, spins):\n",
+    "    terms = [problem.constant]\n",
+    "    terms.extend(problem.field(node) * spins[node] for node in problem.nodes)\n",
+    "    terms.extend(J * spins[u] * spins[v] for (u, v), J in problem.couplings.items())\n",
+    "    return math.fsum(terms)\n",
